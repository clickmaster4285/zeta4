# Public site URL (used for canonical links, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://zetatech.com.pk

# Contact form delivery (SMTP). Leave empty until credentials are available;
# the form will tell the visitor delivery is not configured yet instead of failing silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@zetatech.com.pk
CONTACT_FROM="Zeta Website <no-reply@zetatech.com.pk>"
